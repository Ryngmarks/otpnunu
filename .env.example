# Kopiera till .env och fyll i. .env finns bara på din dator (inte i git).

# PostgreSQL-lösenordet du valde när du installerade PostgreSQL (användaren "postgres")
DB_PASSWORD=

# Riot-nyckeln från developer.riotgames.com. Läses om vid varje synk – ingen omstart behövs.
RIOT_API_KEY=RGAPI-...

# Lösenord för sidan. Med lösenord nås sidan från mobilen på hemnätet; utan bara från datorn.
APP_PASSWORD=

# Valfritt: annan port eller databas
# PORT=8787
# DATABASE_URL=postgres://postgres@localhost:5432/otpnunu
